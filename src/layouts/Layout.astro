---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: 'Muebles Villegas',
  description: 'Carpintería familiar de mueble a medida e interiorismo en Cornellà de Llobregat.',
  image: `${Astro.site}${base}images/armario-medida.webp`.replace(/([^:])\/\//g, '$1/'),
  telephone: '+34615648952',
  email: 'info@mueblesvillegas.es',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Carretera del Prat, 50',
    addressLocality: 'Cornellà de Llobregat',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  areaServed: 'Cornellà de Llobregat y el Baix Llobregat',
  sameAs: ['https://www.google.com/maps/search/?api=1&query=Muebles+Villegas+Carretera+del+Prat+50+Cornell%C3%A0+de+Llobregat'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#211a15" />

    <link
      rel="preload"
      href={`${base}fonts/bricolage-grotesque-variable.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/source-sans-3-variable.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <p class="bg-tinta px-4 py-2 text-center text-xs text-sobre-acento">
      Propuesta de diseño para Muebles Villegas · preparada por
      <a href="https://sergiogarciaweb.com" class="underline underline-offset-2 hover:text-acento-suave">
        Sergio García
      </a>
    </p>
    <slot />
  </body>
</html>
